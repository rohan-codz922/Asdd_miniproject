# Version control
.git
.gitignore

# CI / DevOps source files (not needed in image)
.github
DEVOPS.md

# Next.js build output (rebuilt inside Docker)
.next

# Node modules (reinstalled inside Docker)
node_modules

# Local env files – NEVER bake secrets into the image
.env
.env.local
.env.*.local

# Tests and dev tooling
__tests__
jest.config.js
jest.setup.ts
*.test.ts
*.test.tsx

# Misc
*.md
.DS_Store
npm-debug.log*
